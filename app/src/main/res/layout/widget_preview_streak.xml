<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dusk" android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="DAYMARK" android:textColor="@color/wdg_dusk_soft" android:textSize="10sp" android:fontFamily="sans-serif-medium" />
    <FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="12" android:textColor="@color/wdg_dusk_text" android:textSize="44sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:paddingBottom="8dp" android:text="days" android:textColor="@color/wdg_dusk_soft" android:textSize="14sp" />
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="4:12:09" android:textColor="@color/wdg_dusk_accent" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
</LinearLayout>
