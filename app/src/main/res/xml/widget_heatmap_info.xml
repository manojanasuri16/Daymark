<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_heatmap_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:previewLayout="@layout/widget_preview_heatmap"
    android:configure="com.daymark.app.widget.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:minWidth="250dp" android:minHeight="110dp"
    android:minResizeWidth="180dp" android:minResizeHeight="80dp"
    android:targetCellWidth="4" android:targetCellHeight="2"
    android:maxResizeWidth="520dp" android:maxResizeHeight="520dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
